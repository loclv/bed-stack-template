{
	"name": "bed-stack",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "NODE_ENV=development bun run --title='Bun Monorepo' --filter '*' dev",
		"d": "bun run dev:api & bun run dev:web",
		"dev:web": "bun --cwd packages/web dev",
		"w": "bun --cwd packages/web dev",
		"dev:api": "bun --cwd apps/auth-service dev & bun --cwd apps/seat-service dev & bun --cwd apps/payment-service dev",
		"a": "bun run dev:api",
		"build": "bun run build:web && bun run build:api",
		"build:web": "bun --cwd packages/web build",
		"build:api": "bun --cwd apps/auth-service build && bun --cwd apps/seat-service build && bun --cwd apps/payment-service build",
		"start": "bun run start:api & bun run start:web",
		"start:web": "bun --cwd packages/web start",
		"start:api": "bun --cwd apps/auth-service start & bun --cwd apps/seat-service start & bun --cwd apps/payment-service start",
		"fmt": "bunx biome format --write .",
		"lint": "bunx biome check --write --unsafe .",
		"clean:modules": "bash -lc 'find . -type d -name node_modules -prune -print -exec rm -rf {} \\; && rm -f bun.lock'",
		"env:setup": "bun run scripts/copy-envs.ts",
		"postinstall": "bun run env:setup"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/pg": "^8.20.0",
		"pg": "^8.21.0",
		"typescript": "catalog:"
	},
	"engines": {
		"npm": "Please use Bun",
		"yarn": "Please use Bun",
		"pnpm": "Please use Bun",
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"catalog": {
			"typescript": "^5.6.3",
			"@types/bun": "latest",
			"open": "^10.1.0"
		},
		"catalogs": {
			"api": {
				"@elysiajs/cors": "^1.4.0",
				"@elysiajs/jwt": "^1.4.0",
				"@elysiajs/openapi": "^1.4.14",
				"@sinclair/typebox": "^0.34.48",
				"bun-types": "latest",
				"drizzle-orm": "^0.45.1",
				"drizzle-typebox": "^0.3.3",
				"elysia": "^1.4.27",
				"google-auth-library": "^10.6.1",
				"nanoid": "^5.0.4"
			},
			"web": {
				"react": "^19.2.3",
				"react-dom": "^19.2.3",
				"@biomejs/biome": "2.3.8",
				"@rsbuild/core": "^1.7.1",
				"@rsbuild/plugin-react": "^1.4.2",
				"@tailwindcss/postcss": "^4.1.18",
				"@testing-library/jest-dom": "^6.9.1",
				"@testing-library/react": "^16.3.2",
				"@testing-library/user-event": "^14.6.1",
				"@types/jsdom": "^28.0.0",
				"@types/react": "^19.2.7",
				"@types/react-dom": "^19.2.3",
				"jsdom": "^28.1.0",
				"tailwindcss": "^4.1.18"
			}
		}
	},
	"lint-staged": {
		"**/*.{ts,tsx,js,jsx,css,md,json}": [
			"bunx --bun biome check --write --unsafe"
		]
	}
}
