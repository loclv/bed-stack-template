# ==============================================================================
# Seat Reservation - Microservices Environment Configurations
# ==============================================================================

# Node Environment (production / development)
NODE_ENV=development

# Log Level (debug / info / warn / error)
LOG_LEVEL=info

# ─── Auth Service Configurations ──────────────────────────────────────
AUTH_PORT=3001
# PostgreSQL Connection Strings for individual microservices (local dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_db
SEAT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/seat_db
PAYMENT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_db
# Redis connection URL
REDIS_URL=redis://localhost:6379
# Google OAuth Credentials (retrieve from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# JWT Signatures - REQUIRED (throw error if missing, no fallback in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production

# JWT TTL Configuration (Seconds)
JWT_AT_TTL_SECONDS=900
RT_TTL_SECONDS=7776000
RT_GRACE_WINDOW_SECONDS=10

# ─── Seat Service Configurations ──────────────────────────────────────
SEAT_PORT=3002
# PostgreSQL Connection String for Seat database
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/seat_db
# Kafka brokers list (comma-separated)
KAFKA_BROKERS=localhost:9092
# Hold lock TTL (Seconds)
HOLD_TTL_SECONDS=300
# background sweeper interval (ms)
SWEEPER_INTERVAL_MS=30000
SWEEPER_BATCH_SIZE=50

# ─── Payment Service Configurations ───────────────────────────────────
PAYMENT_PORT=3003
# PostgreSQL Connection String for Payment database
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_db
# Stripe Keys (used in mock mode if non-production)
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_mock_secret
WEBHOOK_TOLERANCE_SECONDS=300

# ─── Nginx / Web Frontend Configurations ──────────────────────────────
# Public Endpoint of Nginx Gateway (exposed to frontend)
PUBLIC_API_URL=http://localhost:3000/api
WEB_URL=http://localhost:4097
TRUST_PROXY=true
