# Payment Service Environment Variables
NODE_ENV=development
LOG_LEVEL=info
PAYMENT_PORT=3003

# Database Configuration (local development defaults)
PAYMENT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432

# Redis & Kafka
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# JWT Keys - REQUIRED (Must match other services)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production

# Stripe Keys (Mock mode triggers if non-production)
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_mock_secret
WEBHOOK_TOLERANCE_SECONDS=300

# Web URL & Trust Proxy
WEB_URL=http://localhost:4097
TRUST_PROXY=true
