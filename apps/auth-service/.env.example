# Auth Service Environment Variables
NODE_ENV=development
LOG_LEVEL=info
AUTH_PORT=3001

# Database Configuration (local development defaults)
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432

# Redis & Kafka
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# JWT Keys - REQUIRED (Must be changed in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production

# JWT TTL Configuration (Seconds)
JWT_AT_TTL_SECONDS=900
RT_TTL_SECONDS=7776000
RT_GRACE_WINDOW_SECONDS=10

# Google OAuth Credentials (retrieve from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Web URL & Trust Proxy
WEB_URL=http://localhost:4097
TRUST_PROXY=true
